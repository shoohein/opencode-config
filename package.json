{
  "dependencies": {
    "@opencode-ai/plugin": "1.17.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "format:mdyml": "prettier --write \"**/*.{md,yml,yaml}\"",
    "check:mdyml": "prettier --check \"**/*.{md,yml,yaml}\"",
    "format:ts": "biome format --write .",
    "check:ts": "biome format .",
    "lint:ts": "biome check .",
    "lint:ts:fix": "biome check --write .",
    "format:sh": "git ls-files '*.sh' '.husky/*' 'bin/*' 'scripts/*' | xargs shfmt -w",
    "check:sh": "git ls-files '*.sh' '.husky/*' 'bin/*' 'scripts/*' | xargs shfmt -d",
    "lint:sh": "git ls-files '*.sh' '.husky/*' 'bin/*' 'scripts/*' | xargs shellcheck",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,yml,yaml}": [
      "prettier --write"
    ],
    "*.sh": [
      "shfmt -d",
      "shellcheck"
    ]
  }
}
